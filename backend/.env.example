# 应用配置
APP_NAME=企业智能知识库助手
DEBUG=True

# 数据库（SQLite；生产可切换 PostgreSQL，见文末示例）
DATABASE_URL=sqlite:///./knowledge_base.db
# 启动时是否自动建表（create_all）。生产必须 false，否则改表结构不会生效。
# 首次启动前执行：alembic upgrade head（已有库先 alembic stamp head）
AUTO_CREATE_TABLES=false

# JWT 密钥——**这一项必须自己生成，不能照抄**。
# 下面的值只是占位符：它写在源码里、人人可见，用它签名等于任何人都能伪造 token。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 行为说明：容器内 DEBUG=false，若检测到仍是这个占位值，后端会**拒绝启动**并打印原因
#（本地裸跑 DEBUG=true 时不拦，方便调试）。
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
# 默认 7 天。需要"登出即失效"已由 jti 吊销实现，调短可进一步缩小泄露窗口。
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM 配置（OpenAI 兼容接口，可切换豆包/通义/DeepSeek/OpenAI）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-pro-32k
EMBEDDING_MODEL=embedding-3

# LLM 容错
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt,md,jpg,jpeg,png

# 向量数据库
VECTOR_DB_PATH=./chroma_db
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# 父子分块：小块检索、大块返回
PARENT_CHUNK_ENABLED=True
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=250
TOP_K=5
# 相似度阈值（低于该分数的片段被过滤，降低幻觉）
SIMILARITY_THRESHOLD=0.3

# Embedding 缓存
EMBEDDING_CACHE_ENABLED=True
EMBEDDING_CACHE_PATH=./embedding_cache.json
# 缓存条目上限（超出后按插入序批量回收至 90%）。设 0 或负数表示不限。
EMBEDDING_CACHE_MAX_ENTRIES=20000
# 落盘节流间隔（秒）：一次检索会有 N 个改写查询，每次都全量写盘毫无必要。
# 进程正常退出时会把未落盘的改动补刷一次。
EMBEDDING_CACHE_FLUSH_INTERVAL=30

# 接口限流
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 检索增强 =====
# vector=纯向量；hybrid=BM25+向量混合(RRF)
RETRIEVAL_MODE=hybrid
BM25_INDEX_DIR=./bm25_index
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
RRF_K=60
FETCH_K=20
# 稀疏路相关性下限。实际生效门槛 = min(BM25_MIN_SCORE, 头名分数 × BM25_MIN_SCORE_RATIO)：
# 大语料靠绝对值过滤常见词；小语料自动退化为"相对头名 25%"，不会把候选全杀光
#（BM25 绝对分随语料规模下降，固定阈值在 1-2 个切片的小库上会让检索静默返回空）。
BM25_MIN_SCORE=0.5
BM25_MIN_SCORE_RATIO=0.25
# Rerank
RERANK_ENABLED=True
RERANK_PROVIDER=llm
RERANK_TOP_N=5
# 精排时每个候选送入模型的最大字符数。父子分块下 text 是 1000 字父块，
# 20 个候选全量送入约 1.2-1.5 万 token；截到 200 字可省约 80%，排序质量基本不变。
RERANK_MAX_CHARS=200
COHERE_API_KEY=
# 查询改写
QUERY_REWRITE_ENABLED=True
MULTI_QUERY_COUNT=3
HYDE_ENABLED=False

# ===== 上下文工程 =====
CONTEXT_MAX_TOKENS=6000
HISTORY_COMPRESS_ENABLED=True
HISTORY_KEEP_TURNS=6
MEMORY_ENABLED=True
LONG_MEMORY_PATH=./long_memory.json
TOOL_BUDGET=10

# ===== 评测 =====
EVAL_DATASET_PATH=./app/evaluation/data/golden_qa.json
EVAL_REPORT_DIR=./eval_reports
LLM_JUDGE_ENABLED=True

# ===== 可观测性（Langfuse）=====
LANGFUSE_ENABLED=False
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Agent 编排 =====
ORCHESTRATION_BACKEND=native

# ===== A2A 协议（对外暴露 Agent 能力）=====
# 默认关闭；对外开放时改成 True 并生成随机 Token：
# python -c "import secrets;print(secrets.token_urlsafe(32))"
A2A_ENABLED=False
A2A_TOKEN=
A2A_PUBLIC_URL=http://localhost:8000/a2a/

# ===== 生产化（Celery / Redis / Qdrant）=====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 异步任务：thread=本地线程（开发）；celery=Celery 队列（生产）
ASYNC_MODE=thread
# 向量库：chroma=本地 Chroma（开发）；qdrant=Qdrant（生产）
VECTOR_PROVIDER=chroma
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Embedding 向量维度
EMBEDDING_DIM=1024

# ===== 成本监控 =====
COST_TRACKING_ENABLED=True

# ===== 前沿能力 =====
# Self-RAG：检索后自检，资料不足自动改写重检索（增加 LLM 调用，默认关闭）
SELF_RAG_ENABLED=False
# 多模态：图片理解（VLM 描述，失败降级 OCR）
MULTIMODAL_ENABLED=True

# ===== GraphRAG（知识图谱增强检索）=====
GRAPHRAG_ENABLED=True
# 局部检索：种子实体数、邻居扩展跳数
GRAPHRAG_TOP_ENTITIES=5
GRAPHRAG_LOCAL_HOPS=1
# 全局检索：参与 map-reduce 的社区数
GRAPHRAG_TOP_COMMUNITIES=6

# ===== 推理模型 / 推理时计算 =====
# 推理模型（带思考链，如 deepseek-r1、doubao-thinking、o 系列）
REASONING_ENABLED=True
REASONING_MODEL=deepseek-r1
# 是否对复杂问题自动启用推理（false 时全部走普通模型，省时省钱）
REASONING_AUTO=True
# Self-Consistency：多次采样取多数一致（成本高，默认关闭）
SELF_CONSISTENCY_ENABLED=False
SELF_CONSISTENCY_SAMPLES=3
# 问题长度低于此值且无复杂词，直接走普通模型
REASONING_MIN_QUESTION_LEN=15

# ----------------------------------------------------------
# 生产环境 PostgreSQL 切换示例（安装 psycopg2-binary 后启用）：
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/kb
# 生产环境推荐组合：ASYNC_MODE=celery + VECTOR_PROVIDER=qdrant
# ----------------------------------------------------------
